# ==============================================================================
# ZelaAI - Configuração de Variáveis de Ambiente (.env.example)
# Copie este arquivo para ".env" na raiz do projeto e preencha sua chave gratuita.
# Nunca versione o arquivo ".env" real no Git!
# ==============================================================================

# 1. Provedor de Inteligência Artificial (Google Gemini API - Gratuita no Google AI Studio)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
GEMINI_MODEL_NAME=gemini-2.5-flash

# 2. Segurança e CORS do Back-end FastAPI (Lista separada por vírgulas, sem uso de '*' em produção)
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://zelaai.streamlit.app

# 3. Comunicação entre Front-end (Streamlit) e Back-end (FastAPI)
API_BASE_URL=http://localhost:8000
EXTERNAL_API_TIMEOUT_SECONDS=12.0
